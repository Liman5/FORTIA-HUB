  enterpriseFeeFcfa Decimal @default(30000) @db.Decimal(10, 2) @map("enterprise_fee_fcfa")
  buyerFeeUsd      Decimal  @default(0) @db.Decimal(10, 2) @map("buyer_fee_usd")
  feeEnabled       Boolean  @default(true) @map("fee_enabled")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("registration_fee_config")
}

model PlatformConfig {
