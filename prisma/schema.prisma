// ============================================================
// PAIEMENTS & TRANSACTIONS
// ============================================================
model PaymentGateway {
  id               String             @id @default(uuid())
  code             PaymentGatewayCode @unique
  name             String
  description      String             @default("")
  isActive         Boolean            @default(false) @map("is_active")
  isDefault        Boolean            @default(false) @map("is_default")
  displayOrder     Int                @default(0) @map("display_order")
  config           Json               @default("{}")
  feeStructure     GatewayFeeStruct   @default(percentage) @map("fee_structure")
  feeValue         Decimal            @default(0) @db.Decimal(6, 2) @map("fee_value")
  feeCurrency      String             @default("USD") @map("fee_currency")
  minAmountUsd     Decimal            @default(0) @db.Decimal(10, 2) @map("min_amount_usd")
  maxAmountUsd     Decimal?           @db.Decimal(10, 2) @map("max_amount_usd")
  supportedCountries String[]         @default([]) @map("supported_countries")
  bankAccountName  String             @default("") @map("bank_account_name")
  bankAccountNumber String            @default("") @map("bank_account_number")
  bankProviderName String             @default("") @map("bank_provider_name")
  isTestMode       Boolean            @default(true) @map("is_test_mode")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  transactions     PaymentTransaction[]

  @@map("payment_gateways")
}

model PaymentTransaction {
  id             String          @id @default(uuid())
  orderId        String?         @unique @map("order_id")

  gatewayId      String?         @map("gateway_id")
  userId         String?         @map("user_id")
  amountUsd      Decimal         @default(0) @db.Decimal(10, 2) @map("amount_usd")
  amountFcfa     Decimal         @default(0) @db.Decimal(14, 2) @map("amount_fcfa")
  currency       String          @default("USD")
  transactionRef String          @unique @map("transaction_ref")
  providerRef    String          @default("") @map("provider_ref")
  status         PaymentStatus   @default(En_attente)
  gatewayResponse Json           @default("{}") @map("gateway_response")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  order          MarketplaceOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  gateway        PaymentGateway?   @relation(fields: [gatewayId], references: [id], onDelete: SetNull)
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([gatewayId])
  @@map("payment_transactions")
}

model PaymentWebhook {
  id              String            @id @default(uuid())
  gatewayCode     PaymentGatewayCode @map("gateway_code")
  eventType       String            @default("") @map("event_type")
  payload         Json              @default("{}")
  receivedAt      DateTime          @default(now()) @map("received_at")
  processed       Boolean           @default(false)
  processingError String            @default("") @map("processing_error")

  @@index([gatewayCode])
  @@index([processed])
  @@map("payment_webhooks")
}

model RegistrationFeeConfig {
