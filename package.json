{
  "name": "fortia-hub",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build --turbopack",
    "start": "next start",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --conditions=react-server --test tests/unit/*.test.ts",
    "check:boundaries": "node scripts/check-module-boundaries.mjs",
    "test:authz": "node scripts/test-write-authorization.mjs",
    "test:payments": "node scripts/test-payments-phase2.mjs",
    "test:academy": "node scripts/test-academy-certificates.mjs",
    "test:db": "node scripts/test-database-integrity.mjs",
    "test:migrations": "node scripts/test-migrations-replay.mjs",
    "test:database": "node scripts/test-migrations-replay.mjs && node scripts/test-database-integrity.mjs",
    "test:modules": "node scripts/test-module-services.mjs",
    "test:security": "node scripts/test-security-authz.mjs",
    "test:admin-users": "node scripts/test-admin-users.mjs",
    "test:integration": "node scripts/test-write-authorization.mjs && node scripts/test-payments-phase2.mjs && node scripts/test-academy-certificates.mjs && node scripts/test-module-services.mjs && node scripts/test-security-authz.mjs && node scripts/test-admin-users.mjs && node scripts/test-migrations-replay.mjs && node scripts/test-database-integrity.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:boundaries && npm test && npm run test:database",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1105.0",
    "@aws-sdk/s3-request-presigner": "^3.1105.0",
    "@google/genai": "^2.4.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "jose": "^6.2.10",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^16.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^6.18.1",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.5.3",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.35.0"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
