# Interrupteur TEMPORAIRE de la vérification d'adresse e-mail à l'inscription.
#   required (défaut) = code OTP obligatoire
#   off               = inscription SANS code, uniquement si RESEND_API_KEY est vide
# Dès qu'une RESEND_API_KEY est renseignée, la vérification redevient
# obligatoire automatiquement (aucun code à modifier).
EMAIL_VERIFICATION_MODE=required

# Envoi des e-mails transactionnels (codes de vérification, réinitialisation)
RESEND_API_KEY=
SENDER_EMAIL=
# Gemini API (assistant IA) - clé obtenue sur https://aistudio.google.com/apikey
# La clé est utilisée UNIQUEMENT côté serveur (app/api/ai-assistant/route.ts),
# elle n'est jamais exposée au navigateur.
GEMINI_API_KEY=
# Modèle Gemini utilisé par l'assistant IA (changeable sans modifier le code).
# Défaut si absent : gemini-3.7-flash (disponible dans le Free Tier).
# Autres modèles Flash gratuits : gemini-3.6-flash, gemini-3.5-flash,
# gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-3.7-flash
# Modèles de secours tentés automatiquement si GEMINI_MODEL renvoie un 503
# (forte affluence) ou 429 (quota). Séparés par des virgules.
# Défaut si absent : gemini-3.6-flash,gemini-3.5-flash
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash
# Supabase Auth (réinitialisation de mot de passe par email)
# L'origine SUPABASE_URL est aussi autorisée dans la CSP (lue au build).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Base de données (Supabase Postgres via Prisma)
DATABASE_URL=
# Cloudflare R2 (stockage)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_BUCKET_ACCESS_KEY=
CLOUDFLARE_BUCKET_SECRET_KEY=
# Bucket PUBLIC : images uniquement (logos boutiques, images produits, blog, CMS).
CLOUDFLARE_BUCKET_NAME=
# Bucket PRIVE : documents KYC, livrables produits (PDF/ZIP), videos de formation.
# ⚠️ Ce bucket ne doit PAS avoir de domaine public activé (voir docs/R2-STOCKAGE-PRIVE.md).
# ⚠️ OBLIGATOIRE en production. Exemple : CLOUDFLARE_PRIVATE_BUCKET_NAME=fortia-hub-private
# Sans cette variable, l'application REFUSE les téléversements privés (erreur 503
# « Stockage privé non configuré ») au lieu de les écrire dans le bucket public.
# Vérification : GET /api/storage/health (connecté en admin) → champ `privateBucket`.
CLOUDFLARE_PRIVATE_BUCKET_NAME=

# ------------------------------------------------------------
# ACCÈS ADMINISTRATION PAR L'EMAIL (facultatif)
# ------------------------------------------------------------
# Les comptes dont l'email figure dans `admin_users` sont reconnus comme
# administrateurs, même si leur compte membre garde un autre rôle.
# Cette liste blanche (séparée par des virgules) accorde en plus le rôle
# superadmin à ces adresses, sans passer par la table.
# Exemple : ADMIN_EMAILS=vous@exemple.com,associe@exemple.com
ADMIN_EMAILS=
# Clés API DEDIEES au bucket privé (facultatif mais recommandé).
# Créez un jeton R2 limité à ce seul bucket (Object Read & Write) :
# R2 → Manage R2 API Tokens → Create API Token → Bucket scopes = bucket privé.
# Si ces deux variables sont vides, les clés principales (ci-dessus) sont utilisées.
CLOUDFLARE_PRIVATE_BUCKET_ACCESS_KEY=
CLOUDFLARE_PRIVATE_BUCKET_SECRET_KEY=
CLOUDFLARE_BUCKET_ENDPOINT=
# Domaine PUBLIC du bucket public (utilise pour construire les URLs des images).
# Il est aussi declare dans la CSP (img-src / connect-src / media-src) : renseignez-le AVANT le build.
CLOUDFLARE_BUCKET_PUBLIC_URL=
# URL publique de l'application
NEXT_PUBLIC_APP_URL=

# ============================================================
# PRODUCTION — POOL DE CONNEXIONS POSTGRESQL (important)
# ------------------------------------------------------------
# En hébergement serverless, chaque instance ouvre un pool de connexions.
# Avec Supabase, utilisez le POOLER en mode transaction :
#   DATABASE_URL="postgresql://...@...pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# et limitez le pool côté application :
DATABASE_POOL_MAX=5
# Journalisation SQL Prisma : laisser vide en usage normal (logs silencieux).
# Mettre true uniquement pour diagnostiquer une requête lente.
PRISMA_LOG_QUERIES=
# (Sans cela, beaucoup de visiteurs simultanés épuisent le pool :
#  erreur Prisma P2039 et connexion impossible.)
# Secret JWT (sessions utilisateur - cookie HttpOnly)
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT : changer en production et ne jamais exposer.
JWT_SECRET=
# Web Push (VAPID) — notifications push du navigateur même lorsque l'app est fermée.
# Générées UNE SEULE FOIS avec : node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys(),null,2))"
# La clé PRIVÉE reste EXCLUSIVEMENT côté serveur, elle n'est jamais exposée au navigateur.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Adresse de contact (mailto:) incluse dans les en-têtes VAPID
VAPID_SUBJECT=mailto:contact@fortiahub.com

# ============================================================
# MAINTENANCE DE PRODUCTION
# ============================================================
# Secret du job de maintenance (/api/cron/maintenance) :
#  • nettoyage des fichiers R2 orphelins (> 24 h, simulation par défaut)
#  • purge des compteurs de limitation de débit expirés
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Vercel Cron transmet automatiquement « Authorization: Bearer <CRON_SECRET> ».
CRON_SECRET=

# Phase 2 - Paiements
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
PAYMENTS_SANDBOX_ENABLED=false
PAYMENTS_SANDBOX_ALLOW_PROD=false
SANDBOX_WEBHOOK_SECRET=
